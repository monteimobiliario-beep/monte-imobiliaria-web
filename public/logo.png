<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="100%" height="100%">
  <!-- Corporate Base Background: Premium Navy Deep Blue Squircle with rounded corners (rx=120) -->
  <rect x="16" y="16" width="480" height="480" rx="120" fill="#0d1e34" />

  <!-- Outer Stylized Hexagonal House Frame -->
  <path d="M 118,205 L 256,120 L 394,205 L 394,305 L 256,385 L 118,305 Z" 
        fill="none" 
        stroke="#ffffff" 
        stroke-width="15" 
        stroke-linejoin="round" 
        stroke-linecap="round" />

  <!-- Chimney on Left Roof Slope -->
  <rect x="148" y="145" width="16" height="40" fill="#ffffff" />
  <rect x="142" y="137" width="28" height="8" rx="2" fill="#ffffff" />

  <!-- Building Floor parallel V-Shape line -->
  <path d="M 136,300 L 256,370 L 376,300" 
        stroke="#ffffff" 
        stroke-width="15" 
        stroke-linejoin="round" 
        stroke-linecap="round" 
        fill="none" />

  <!-- Skyscrapers Group -->
  <!-- Building 1: Leftmost -->
  <path d="M 142,305 L 142,245 L 166,231 L 166,318 Z" fill="#ffffff" />
  <rect x="149" y="255" width="8" height="12" rx="1.5" fill="#0d1e34" />
  <rect x="149" y="275" width="8" height="12" rx="1.5" fill="#0d1e34" />
  <rect x="149" y="295" width="8" height="10" rx="1.5" fill="#0d1e34" />

  <!-- Building 2: Middle-Left -->
  <path d="M 172,319 L 172,216 L 196,202 L 196,334 Z" fill="#ffffff" />
  <rect x="179" y="222" width="8" height="14" rx="1.5" fill="#0d1e34" />
  <rect x="179" y="244" width="8" height="14" rx="1.5" fill="#0d1e34" />
  <rect x="179" y="266" width="8" height="14" rx="1.5" fill="#0d1e34" />
  <rect x="179" y="288" width="8" height="14" rx="1.5" fill="#0d1e34" />

  <!-- Building 3: Middle-Right (tall skyscraper) -->
  <path d="M 304,328 L 304,165 L 330,178 L 330,315 Z" fill="#ffffff" />
  <rect x="312" y="184" width="8" height="14" rx="1.5" fill="#0d1e34" />
  <rect x="312" y="206" width="8" height="14" rx="1.5" fill="#0d1e34" />
  <rect x="312" y="228" width="8" height="14" rx="1.5" fill="#0d1e34" />
  <rect x="312" y="250" width="8" height="14" rx="1.5" fill="#0d1e34" />
  <rect x="312" y="272" width="8" height="14" rx="1.5" fill="#0d1e34" />

  <!-- Building 4: Rightmost Tower -->
  <path d="M 342,309 L 342,190 L 362,200 L 362,299 Z" fill="#ffffff" />
  <rect x="350" y="208" width="4" height="75" rx="1" fill="#0d1e34" />

  <!-- Smaller Center House (placed as an overlay over skyscrapers) -->
  <path d="M 206,312 L 256,280 L 306,312 Z" 
        stroke="#ffffff" 
        stroke-width="15" 
        stroke-linejoin="round" 
        fill="#0d1e34" />

  <!-- Window Grid inside the Center House -->
  <rect x="242" y="306" width="10" height="10" rx="1" fill="#ffffff" />
  <rect x="260" y="306" width="10" height="10" rx="1" fill="#ffffff" />
  <rect x="242" y="324" width="10" height="12" rx="1" fill="#ffffff" />
  <rect x="260" y="324" width="10" height="12" rx="1" fill="#ffffff" />
</svg>
